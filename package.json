{
  "name": "metro-map",
  "private": true,
  "description": "Offline-first route planner for the Moscow Metro: canvas diagram from a Go layout solver, on-device routing, PWA.",
  "keywords": [
    "moscow-metro",
    "metro-map",
    "transit-diagram",
    "octolinear-layout",
    "canvas",
    "pwa",
    "offline-first",
    "route-planning",
    "react",
    "typescript"
  ],
  "homepage": "https://metro.samoy.love",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samoy-love/metro-map.git"
  },
  "bugs": "https://github.com/samoy-love/metro-map/issues",
  "author": "Alexey Samoylov <alex@samoy.love>",
  "license": "MIT",
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "vite --mode pwa",
    "dev:editor": "vite --mode editor",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/metro-icon-maskable.svg",
    "build:data": "cd go-layout-solver && go run . -data ../data -out ../normalized/fullGraph.json",
    "quality": "tsx scripts/quality/analyze.ts",
    "quality:check": "tsx scripts/quality/analyze.ts --check",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "check:css": "node scripts/check-css-tokens.mjs",
    "test:unit": "vitest run --coverage --exclude \"**/labelLayoutRepeat.test.ts\"",
    "test:repeat": "vitest run scripts/quality/labelLayoutRepeat.test.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
